# Copy to .env; secrets stay on the server. Node 24+ required.
HOST=127.0.0.1
PORT=4318
NODE_ENV=development
DATA_DIR=./data
# Production: set the exact HTTPS origin and a random first-setup token.
APP_ORIGIN=http://127.0.0.1:5173
SETUP_TOKEN=
# Local assistant. Obtain a scoped token from Settings after creating account.
WORKBENCH_URL=http://127.0.0.1:4318
WORKBENCH_AGENT_TOKEN=
# Optional absolute executable path; omit to use codex on PATH.
CODEX_BIN=
# Optional explicit Codex home for assistant user launch. No secret needs copying.
CODEX_HOME=
