{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "personal-workbench",
  "pages_build_output_dir": "./dist",
  "compatibility_date": "2026-10-04",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "APP_ORIGIN": "https://moyaiwork.com",
    "AI_ALLOWED_HOSTS": ""
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "workbench",
      // Replace this with the UUID printed by `wrangler d1 create workbench`.
      "database_id": "f4fcc9a9-067c-43dd-9e2e-f89c05fa357a",
      "migrations_dir": "cloudflare/migrations"
    }
  ]
}
